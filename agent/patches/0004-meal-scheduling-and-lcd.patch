@@ -596,6 +596,49 @@ static void cmd_ask(int argc, char** argv)
             strncat(content, " ", sizeof(content) - strlen(content) - 1);
     }
 
+    /* velapaw: fgets() hands over terminal editing as raw bytes -- arrow keys
+     * as ESC [ D / ESC O D, backspace as 0x08 or 0x7f -- so a line corrected
+     * on screen reached the model as something else.  On 2026-10-13 a line
+     * that showed "set bob's dinner to 18:50" arrived as 31 bytes; the model
+     * answered "Done ... 18:50" without ever calling set_meal_schedule.
+     * Apply the erases, drop escape sequences and other control bytes.
+     * Bytes >= 0x80 pass, so Chinese input is untouched. */
+    size_t w = 0;
+    for (size_t r = 0; content[r] != '\0'; r++) {
+        unsigned char c = (unsigned char)content[r];
+        if (c == 0x1b) {
+            if (content[r + 1] == '[' || content[r + 1] == 'O') {
+                r += 2;                         /* skip to the final byte */
+                while (content[r] != '\0' &&
+                       ((unsigned char)content[r] < 0x40 ||
+                        (unsigned char)content[r] > 0x7e))
+                    r++;
+                if (content[r] == '\0')
+                    break;
+            } else if (content[r + 1] != '\0') {
+                r++;                            /* two-byte ESC x */
+            }
+            continue;
+        }
+        if (c == 0x08 || c == 0x7f) {
+            /* erase one character: a whole UTF-8 sequence, not one byte */
+            while (w > 0 && ((unsigned char)content[w - 1] & 0xc0) == 0x80)
+                w--;
+            if (w > 0)
+                w--;
+            continue;
+        }
+        if (c < 0x20)
+            continue;
+        content[w++] = (char)c;
+    }
+    content[w] = '\0';
+
+    if (w == 0) {
+        printf("Usage: ask <message>\n");
+        return;
+    }
