 /* Build OpenAI-format assistant message with tool_calls at the top level */
+/* DeepSeek rejects the ENTIRE request with
+ *   HTTP 400 ... messages[N].content: invalid unicode code point
+ * when any message content holds a malformed UTF-8 sequence.  Text cut at a
+ * byte boundary mid-character does exactly that, and because the cut text is
+ * kept in history it poisons every later turn too.  It hurts most right after
+ * a SUCCESSFUL mutating tool call: the write is already on flash, so the owner
+ * is told "Sorry, I encountered an error" about an action that worked
+ * (velapaw set_meal_schedule, 2026-10-11).
+ *
+ * Returns the length of the longest well-formed UTF-8 prefix of s.  Reading
+ * p[i + k] can never run past the terminator: a NUL fails the continuation
+ * test and stops the scan.
+ */
+
+static size_t utf8_valid_prefix(const char* s)
+{
+    const unsigned char* p = (const unsigned char*)s;
+    size_t i = 0;
+
+    while (p[i]) {
+        unsigned char c = p[i];
+        int need;
+
+        if (c < 0x80) {
+            i++;
+            continue;
+        } else if ((c & 0xE0) == 0xC0) {
+            need = 1;
+        } else if ((c & 0xF0) == 0xE0) {
+            need = 2;
+        } else if ((c & 0xF8) == 0xF0) {
+            need = 3;
+        } else {
+            break;      /* stray continuation byte, or 0xF8..0xFF */
+        }
+
+        for (int k = 1; k <= need; k++) {
+            if ((p[i + k] & 0xC0) != 0x80) {
+                return i;
+            }
+        }
+        i += need + 1;
+    }
+
+    return i;
+}
+
+/* Attach a string that is guaranteed to be well-formed UTF-8.  The common
+ * case costs nothing: a clean string is handed straight to cJSON with no
+ * copy.  Only a malformed one is duplicated and truncated. */
+
+static void add_clean_string(cJSON* obj, const char* key, const char* val)
+{
+    if (val == NULL) {
+        cJSON_AddNullToObject(obj, key);
+        return;
+    }
+
+    size_t full = strlen(val);
+    size_t valid = utf8_valid_prefix(val);
+
+    if (valid == full) {
+        cJSON_AddStringToObject(obj, key, val);
+        return;
+    }
+
+    syslog(LOG_WARNING,
+        "[%s] UTF-8: trimmed %d of %d byte(s) from \"%s\"\n",
+        TAG, (int)(full - valid), (int)full, key);
+
+    char* tmp = malloc(valid + 1);
+    if (tmp) {
+        memcpy(tmp, val, valid);
+        tmp[valid] = '\0';
+        cJSON_AddStringToObject(obj, key, tmp);
+        free(tmp);
+    } else {
+        cJSON_AddStringToObject(obj, key, "");
+    }
+}
