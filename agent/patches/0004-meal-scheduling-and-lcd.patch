+/****************************************************************************
+ * tool_meal.h - VelaPaw scheduled-meal tool for the AI Agent
+ ****************************************************************************/
+
+#ifndef AI_AGENT_TOOL_MEAL_H
+#define AI_AGENT_TOOL_MEAL_H
+
+#include <stddef.h>
+
+/**
+ * Set ONE scheduled meal time for an enrolled pet.
+ * Input JSON: { pet, slot (1-3), time ("HH:MM" | "off") }
+ *             hour/minute are accepted instead of time.
+ */
+int tool_meal_set_execute(const char *input_json, char *output,
+                          size_t output_size);
+
+#endif /* AI_AGENT_TOOL_MEAL_H */
