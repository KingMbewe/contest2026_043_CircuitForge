diff --git a/src/tools/tool_meal.c b/src/tools/tool_meal.c
new file mode 100644
index 0000000..ee47724
--- /dev/null
+++ b/src/tools/tool_meal.c
@@ -0,0 +1,164 @@
+#include "tool_meal.h"
+#include "core/message_bus.h"
+#include "infra/cron_service.h"
+#include "agent_config.h"
+#include "cJSON.h"
+#include <errno.h>
+#include <string.h>
+#include <time.h>
+
+/* Implemented in apps/examples/velapaw/identity/identity.c.  Declared by hand
+ * rather than by including identity.h: that header pulls in velapaw.h and the
+ * app's whole include path, which this package does not have.  Same FLAT
+ * image, so the symbol resolves at link time.
+ *
+ * Returns 0, -1 bad args, -2 no such pet, -3 ambiguous name, -4 rejected,
+ * or a negative flash-save rc.
+ */
+
+extern int velapaw_meal_set_by_name(const char *name, int slot, int minute);
+
+static bool meal_is_off(const char *s)
+{
+  return s != NULL && (strcmp(s, "off")     == 0 ||
+                       strcmp(s, "OFF")     == 0 ||
+                       strcmp(s, "Off")     == 0 ||
+                       strcmp(s, "none")    == 0 ||
+                       strcmp(s, "disable") == 0 ||
+                       strcmp(s, "\u5173\u95ed") == 0 ||
+                       strcmp(s, "\u53d6\u6d88") == 0);
+}
+
+static const char *MEAL_USAGE =
+    "Error: missing or bad fields. You MUST provide: pet, slot, time. "
+    "slot is 1, 2 or 3 (1 = earliest meal). time is 24-hour \"HH:MM\", "
+    "or \"off\" to disable that meal. "
+    "Example: {\"pet\":\"bob\",\"slot\":1,\"time\":\"07:30\"}. "
+    "Read /data/ai_agent/velapaw/status.md first for the enrolled pet names "
+    "and their current meal times.";
+
+int tool_meal_set_execute(const char *input_json, char *output,
+                          size_t output_size)
+{
+  cJSON *root = cJSON_Parse(input_json);
+
+  if (!root) {
+      snprintf(output, output_size, "Error: invalid JSON input");
+      return ERROR;
+  }
+
+  /* Accept the three field names models actually emit for the pet. */
+  const char *pet = cJSON_GetStringValue(cJSON_GetObjectItem(root, "pet"));
+  if (!pet) pet = cJSON_GetStringValue(cJSON_GetObjectItem(root, "pet_name"));
+  if (!pet) pet = cJSON_GetStringValue(cJSON_GetObjectItem(root, "name"));
+
+  cJSON *jslot = cJSON_GetObjectItem(root, "slot");
+  if (!cJSON_IsNumber(jslot)) jslot = cJSON_GetObjectItem(root, "meal");
+
+  const char *tstr = cJSON_GetStringValue(cJSON_GetObjectItem(root, "time"));
+  cJSON *jhour = cJSON_GetObjectItem(root, "hour");
+  cJSON *jmin  = cJSON_GetObjectItem(root, "minute");
+
+  if (!pet || !cJSON_IsNumber(jslot)) {
+      snprintf(output, output_size, "%s", MEAL_USAGE);
+      cJSON_Delete(root);
+      return ERROR;
+  }
+
+  int slot = jslot->valueint;          /* owner-facing 1..3 */
+  int minute;
+
+  if (meal_is_off(tstr)) {
+      minute = -1;
+  }
+  else if (tstr != NULL) {
+      int hh = -1, mm = 0;
+      if (sscanf(tstr, "%d:%d", &hh, &mm) < 1 ||
+          hh < 0 || hh > 23 || mm < 0 || mm > 59) {
+          snprintf(output, output_size, "%s", MEAL_USAGE);
+          cJSON_Delete(root);
+          return ERROR;
+      }
+      minute = hh * 60 + mm;
+  }
+  else if (cJSON_IsNumber(jhour)) {
+      int hh = jhour->valueint;
+      int mm = cJSON_IsNumber(jmin) ? jmin->valueint : 0;
+      if (hh < 0 || hh > 23 || mm < 0 || mm > 59) {
+          snprintf(output, output_size, "%s", MEAL_USAGE);
+          cJSON_Delete(root);
+          return ERROR;
+      }
+      minute = hh * 60 + mm;
+  }
+  else {
+      snprintf(output, output_size, "%s", MEAL_USAGE);
+      cJSON_Delete(root);
+      return ERROR;
+  }
+
+  /* `pet` points INTO the cJSON tree, and every branch of the switch below
+   * formats it -- but the tree is freed before the switch runs.  Reading it
+   * after cJSON_Delete() is a use-after-free that put raw heap bytes into the
+   * tool result, which made DeepSeek reject the WHOLE request with
+   *   HTTP 400 ... messages[N].content: invalid unicode code point
+   * while the flash write had already succeeded, so a working action reported
+   * "Sorry, I encountered an error" (2026-10-11).  Copy the name first and
+   * repoint `pet` at the copy, so all six branches below are safe.
+   */
+
+  char petbuf[64];
+  strncpy(petbuf, pet, sizeof(petbuf) - 1);
+  petbuf[sizeof(petbuf) - 1] = '\0';
+  pet = petbuf;
+
+  int rc = velapaw_meal_set_by_name(pet, slot - 1, minute);
+  cJSON_Delete(root);
+
+  switch (rc) {
+    case 0:
+      if (minute < 0) {
+          snprintf(output, output_size,
+                   "Meal %d for %s is now off.", slot, pet);
+      }
+      else {
+          /* State the Model-B gate explicitly: without it the model tells the
+           * owner food appears at that time regardless, which is wrong. */
+          snprintf(output, output_size,
+                   "Meal %d for %s is set to %02d:%02d and saved to flash. "
+                   "The feeder dispenses it only when %s is recognised at the "
+                   "bowl at or after that time, once per day.",
+                   slot, pet, minute / 60, minute % 60, pet);
+      }
+      return OK;
+
+    case -1:
+      snprintf(output, output_size, "%s", MEAL_USAGE);
+      return ERROR;
+
+    case -2:
+      snprintf(output, output_size,
+               "Error: no enrolled pet matches \"%s\". Read "
+               "/data/ai_agent/velapaw/status.md for the enrolled names, then "
+               "retry with one of them.", pet);
+      return ERROR;
+
+    case -3:
+      snprintf(output, output_size,
+               "Error: more than one enrolled pet is called \"%s\". Ask the "
+               "owner which one they mean.", pet);
+      return ERROR;
+
+    case -4:
+      snprintf(output, output_size,
+               "Error: the feeder rejected the update for \"%s\".", pet);
+      return ERROR;
+
+    default:
+      snprintf(output, output_size,
+               "Warning: meal %d for %s was changed in memory but could NOT be "
+               "saved to flash (rc %d), so it will be lost on reboot. Tell the "
+               "owner.", slot, pet, rc);
+      return ERROR;
+  }
+}
