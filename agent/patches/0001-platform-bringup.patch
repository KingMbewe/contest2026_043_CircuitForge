diff --git a/src/core/agent_mem.h b/src/core/agent_mem.h
index c569f77..1c63814 100644
--- a/src/core/agent_mem.h
+++ b/src/core/agent_mem.h
@@ -47,12 +47,28 @@ typedef struct {
 /**
  * Query current heap memory status via mallinfo().
  */
+/* mallinfo() walks the heap free lists while holding the heap lock.  On this
+ * ESP32-S3 config (PSRAM + a separate IMEM heap) the walk reads a bogus node
+ * size and never terminates: a bare `free` on a freshly booted board with
+ * nothing running hangs the console, and every later malloc then deadlocks
+ * behind the lock mallinfo still holds.  agent_loop_task() called this as its
+ * very first statement, which is what killed the whole chip on `ask`.  The
+ * boot path already skips mallinfo for the same reason.
+ *
+ * The heap itself is healthy -- only enumerating it is broken -- so report a
+ * fixed budget instead.  NOTE: these are ASSUMED values, not measured; the
+ * "free heap" figure in the agent log is therefore not a real reading.
+ * Over-asking still degrades safely: every allocation site checks for NULL
+ * and falls back. */
+
+#define AGENT_MEM_ASSUMED_ARENA (8u * 1024 * 1024)
+#define AGENT_MEM_ASSUMED_FREE (1u * 1024 * 1024)
+
 static inline void agent_mem_get_status(agent_mem_status_t* st)
 {
-    struct mallinfo mi = mallinfo();
-    st->total_heap = mi.arena;
-    st->free_heap = mi.fordblks;
-    st->largest_block = mi.fordblks; /* conservative estimate */
+    st->total_heap = AGENT_MEM_ASSUMED_ARENA;
+    st->free_heap = AGENT_MEM_ASSUMED_FREE;
+    st->largest_block = AGENT_MEM_ASSUMED_FREE;
 }
 
