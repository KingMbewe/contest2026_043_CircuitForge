diff --git a/src/tools/tool_registry.c b/src/tools/tool_registry.c
index 33583e7..eb1376e 100644
--- a/src/tools/tool_registry.c
+++ b/src/tools/tool_registry.c
@@ -86,8 +86,47 @@ void tool_registry_register_provider(const char* name,
     syslog(LOG_INFO, "[%s] Registered tool provider: %s\n", TAG, name);
 }
 
+/* VelaPaw: tools that make no sense on a pet feeder.
+ *
+ * Every registered tool's JSON schema is serialised into EVERY LLM
+ * request. Measured on hardware: 9,946 B of a 19,391 B request body was
+ * tool schemas. The pool that send has to fit through is
+ * IOB_NBUFFERS(64) * IOB_BUFSIZE(196) = 12,544 B, less IOB_THROTTLE(24),
+ * so ~7,840 B is usable to a sender -- a single request is ~2.5x the
+ * pool, and the send can only complete by blocking and draining as ACKs
+ * recycle buffers. Shrinking the request is the fix; a send timeout is
+ * not (it turns the load-bearing wait into a hard failure).
+ */
+static const char* const s_excluded_tools[] = {
+    /* wearable sensors */
+    "get_heartrate", "get_steps", "get_wear_state", "vibrate",
+    /* Feishu / Lark office integration */
+    "feishu_doc_create", "feishu_doc_write", "feishu_doc_read",
+    "feishu_doc_list", "feishu_chat_members", "feishu_send_mention",
+    /* music player */
+    "music_search", "music_play", "music_pause", "music_resume",
+    "music_stop", "music_seek", "music_set_volume", "music_status",
+    /* quickapp launcher */
+    "launch_quickapp", "exit_quickapp",
+};
+
+static bool tool_is_excluded(const char* name)
+{
+    for (size_t i = 0;
+         i < sizeof(s_excluded_tools) / sizeof(s_excluded_tools[0]); i++) {
+        if (strcmp(name, s_excluded_tools[i]) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
 static void register_tool(const agent_tool_t* tool)
 {
+    if (tool->name && tool_is_excluded(tool->name)) {
+        return;
+    }
+
     if (s_tool_count >= MAX_TOOLS) {
         syslog(LOG_ERR, "[%s] Tool registry full\n", TAG);
         return;
