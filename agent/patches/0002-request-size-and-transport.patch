+    /* The retry loop above is compiled only for the RPMSG/BLE-tethered
+     * transport, which left this path single-shot: the peer closes
+     * without sending a status line, vela_tls returns < 0, and the
+     * whole turn fails with no second attempt.  Observed on hardware
+     * as "RESP hdr in: 0 bytes" — roughly one firing in three, which
+     * for the proactive heartbeat means pushing an error to the owner
+     * instead of the digest.  Retry here so every caller benefits.
+     *
+     * Only fast failures are retried.  A call that burned the full
+     * watchdog budget has already spent the turn; trying again would
+     * stack another timeout onto an answer that is late anyway, and
+     * for the heartbeat could push one firing into the next interval.
+     */
+    int ret = ERROR;
+
+    for (int attempt = 0; attempt <= AGENT_LLM_HTTP_MAX_RETRIES; attempt++) {
+        if (attempt > 0) {
+            unsigned int delay = AGENT_LLM_RETRY_BASE_SEC << (attempt - 1);
+            syslog(LOG_WARNING, "[%s] HTTP transport failed, retry %d/%d "
+                "after %us\n",
+                TAG, attempt, AGENT_LLM_HTTP_MAX_RETRIES, delay);
+            sleep(delay);
+        }
+
+        /* Both paths call resp_buf_init(), which callocs over rb->data.
+         * Free first so a partially-filled buffer from the previous
+         * attempt is neither leaked nor concatenated onto this one. */
+        resp_buf_free(rb);
+
+        time_t t0 = time(NULL);
+
+        if (use_tls && http_proxy_is_enabled()) {
+            ret = llm_http_via_proxy(post_data, rb, out_status);
+        } else {
+            ret = llm_http_direct(post_data, rb, out_status);
+        }
+
+        if (ret == OK)
+            return OK;
+
+        long elapsed = (long)(time(NULL) - t0);
+        if (elapsed >= AGENT_LLM_TIMEOUT_SEC) {
+            syslog(LOG_WARNING,
+                "[%s] HTTP call failed after %lds (>= %ds watchdog), "
+                "not retrying\n",
+                TAG, elapsed, AGENT_LLM_TIMEOUT_SEC);
+            break;
+        }
+
+        syslog(LOG_WARNING, "[%s] HTTP call failed in %lds "
+            "(attempt %d/%d)\n",
+            TAG, elapsed, attempt + 1, AGENT_LLM_HTTP_MAX_RETRIES + 1);
+    }
+
+    return ret;
 #endif
 }
 
