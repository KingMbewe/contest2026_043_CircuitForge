 static const char *TAG = "context";
 
+/* Advance an offset by what snprintf reported, WITHOUT trusting it.
+ * snprintf returns the length it would have written, so `off = ctx_advance(off, size, snprintf(...))`
+ * walks past `size` on the first truncation; because off is size_t, the next
+ * `size - off` underflows and every later write lands outside the buffer.
+ * Saturate at size - 1 instead: a truncated prompt stays merely truncated. */
+
+static inline size_t ctx_advance(size_t off, size_t size, int n)
+{
+    if (size == 0) return 0;
+    if (off >= size) return size - 1;
+    if (n < 0) return off;
+    if ((size_t)n >= size - off) return size - 1;
+    return off + n;
+}
