index 8154c9609b0..f3dfa42ab10 100644
--- a/arch/xtensa/src/esp32s3/esp32s3_i2s.c
+++ b/arch/xtensa/src/esp32s3/esp32s3_i2s.c
@@ -71,6 +71,22 @@
  * Pre-processor Definitions
  ****************************************************************************/
 
+/* VelaPaw bring-up probes.
+ *
+ * 0 = silent (shipping).  1 = the RX DMA state dump, the per-buffer mic
+ * meter and the pin map, all via syslog(LOG_ERR).
+ *
+ * Kept rather than deleted: these found the RX TDM slot map bug and the
+ * fixed-index start-of-stream transient.  They cannot be left on because the
+ * mic meter fires every 8th RX buffer -- roughly once a second, forever, once
+ * VelaPaw listens continuously from the UI task.
+ *
+ * NOTE all three run in thread context (HPWORK or init).  syslog() from the
+ * I2S ISR faults on this board with EXCCAUSE=0x14 -- do not move them.
+ */
+
+#define VELAPAW_I2S_PROBES 0
+
 /* I2S DMA RX/TX description number */
 
 #define I2S_DMADESC_NUM                 (CONFIG_I2S_DMADESC_NUM)
@@ -731,6 +747,39 @@ static int IRAM_ATTR i2s_txdma_start(struct esp32s3_i2s_s *priv)
  *
  ****************************************************************************/
 
+/* VelaPaw patch #33: RX EOF instrumentation.  Deliberately not static --
+ * the app externs these to print them from the `velapaw voice` probe.
+ * Written from ISR context, so increments only; never log from here.
+ */
+
+uint32_t g_velapaw_rx_eof;    /* RX EOF interrupts seen              */
+uint32_t g_velapaw_rx_match;  /* ... where bfdesc == inlink          */
+uint32_t g_velapaw_rx_miss;   /* ... where it did NOT match          */
+uint32_t g_velapaw_rx_empty;  /* ... entered with rx.act empty       */
+uint32_t g_velapaw_rx_start;  /* i2s_rxdma_start() calls that armed  */
+uint32_t g_velapaw_rx_busy;   /* ... that bailed on a non-empty act  */
+
+/* Patch #34.  Counted at the very top of i2s_rx_interrupt(), so they
+ * separate `the ISR stopped firing altogether` from `the ISR keeps
+ * firing but SUC_EOF is never set`.
+ */
+
+uint32_t g_velapaw_isr_rx;    /* i2s_rx_interrupt() entries          */
+uint32_t g_velapaw_isr_noeof; /* ... with SUC_EOF clear              */
+uint32_t g_velapaw_isr_last;  /* raw IN_INT_ST of the last entry     */
+
+/* Patch #35.  cfg_skip counts redundant reconfigures that were declined;
+ * chst counts real channel restarts; resc counts containers pulled back
+ * out of rx.act after a restart orphaned them.  A healthy session should
+ * read `cfg_skip 3 chst 1 resc 0` -- resc > 0 means the safety net had to
+ * catch something and half 1 did not cover every trigger.
+ */
+
+uint32_t g_velapaw_cfg_skip;  /* #35 half 1, REVERTED: always 0 now  */
+uint32_t g_velapaw_rx_kick;   /* velapaw_i2s_rx_kick() calls         */
+uint32_t g_velapaw_rx_chst;   /* i2s_rx_channel_start() bodies run   */
+uint32_t g_velapaw_rx_resc;   /* containers rescued from a reset     */
+
 #ifdef I2S_HAVE_RX
 static int i2s_rxdma_start(struct esp32s3_i2s_s *priv)
 {
@@ -743,6 +792,12 @@ static int i2s_rxdma_start(struct esp32s3_i2s_s *priv)
 
   if (!sq_empty(&priv->rx.act))
     {
+      /* VelaPaw patch #33: this is the wedge.  Once a container is
+       * stranded in rx.act every later start lands here and RX never
+       * rearms, which is what `rec 1/19` looks like from userspace.
+       */
+
+      g_velapaw_rx_busy++;
       return OK;
     }
 
@@ -769,6 +824,8 @@ static int i2s_rxdma_start(struct esp32s3_i2s_s *priv)
 
   modifyreg32(I2S_RX_CONF_REG(priv->config->port), 0, I2S_RX_START);
 
+  g_velapaw_rx_start++;
+
   sq_addlast((sq_entry_t *)bfcontainer, &priv->rx.act);
 
   return OK;
@@ -1110,6 +1167,13 @@ static void i2s_rx_schedule(struct esp32s3_i2s_s *priv,
 
   /* Move all entries from the rx.act queue to the rx.done queue */
 
+  g_velapaw_rx_eof++;
+
+  if (sq_empty(&priv->rx.act))
+    {
+      g_velapaw_rx_empty++;
+    }
+
   if (!sq_empty(&priv->rx.act))
     {
       /* Remove the next buffer container from the rx.act list */
@@ -1126,8 +1190,22 @@ static void i2s_rx_schedule(struct esp32s3_i2s_s *priv,
           bfdesc = bfdesc->next;
         }
 
+      if (bfdesc != inlink)
+        {
+          /* VelaPaw patch #33: the descriptor walk desynced.  Counted
+           * only -- the container is deliberately left in rx.act so this
+           * build reproduces the stall exactly as before.  Changing the
+           * behaviour here is patch #31's job, and #31 is not in this
+           * build precisely so the measurement is unconfounded.
+           */
+
+          g_velapaw_rx_miss++;
+        }
+
       if (bfdesc == inlink)
         {
+          g_velapaw_rx_match++;
+
           sq_remfirst(&priv->rx.act);
 
           /* Report the result of the transfer */
@@ -1234,6 +1312,7 @@ static void i2s_tx_worker(void *arg)
       i2s_buf_free(priv, bfcontainer);
     }
 
+#if VELAPAW_I2S_PROBES
   /* VelaPaw patch #19: one-shot RX DMA state dump, taken the first time
    * the primed silent TX buffer drains.  This runs on HPWORK (thread
    * context) -- syslog() from the I2S ISR faults on this board.
@@ -1345,6 +1424,7 @@ static void i2s_tx_worker(void *arg)
             }
         }
     }
+#endif /* VELAPAW_I2S_PROBES */
 }
 #endif /* I2S_HAVE_TX */
 
@@ -1424,6 +1504,7 @@ static void i2s_rx_worker(void *arg)
           dmadesc = dmadesc->next;
         }
 
+#if VELAPAW_I2S_PROBES
       /* VelaPaw patch #30: count railed samples and report DC offset, to
        * separate genuine clipping (many railed samples) from a structural
        * boundary artifact (a fixed one or two 0x8000 per buffer).
@@ -1483,6 +1564,7 @@ static void i2s_rx_worker(void *arg)
                    vn ? (int32_t)(vdc / (int64_t)vn) : 0, vrail, vm8);
           }
       }
+#endif /* VELAPAW_I2S_PROBES */
 
       /* Perform the RX transfer done callback */
 
@@ -1616,12 +1698,14 @@ static void i2s_configure(struct esp32s3_i2s_s *priv)
                              priv->config->din_insig, 0);
     }
 
+#if VELAPAW_I2S_PROBES
   syslog(LOG_ERR, "VP: i2s pins din=%d dout=%d bclk=%d ws=%d mclk=%d "
                   "role=%d tx_en=%d rx_en=%d\n",
          priv->config->din_pin, priv->config->dout_pin,
          priv->config->bclk_pin, priv->config->ws_pin,
          priv->config->mclk_pin, priv->config->role,
          priv->config->tx_en, priv->config->rx_en);
+#endif /* VELAPAW_I2S_PROBES */
 
   if (priv->config->role == I2S_ROLE_SLAVE)
     {
@@ -2450,6 +2534,38 @@ static void i2s_rx_channel_start(struct esp32s3_i2s_s *priv)
 
       modifyreg32(I2S_RX_CONF_REG(priv->config->port), 0, I2S_RX_UPDATE);
 
+      /* VelaPaw patch #35, the safety net.  The resets above wiped the
+       * GDMA IN channel and the RX FIFO.  Anything that was in flight is
+       * now orphaned: its descriptor still has the owner bit set, no EOF
+       * will ever arrive for it, and because it is never removed from
+       * rx.act every later i2s_rxdma_start() bails at the
+       * `!sq_empty(&priv->rx.act)` test -- RX never re-arms again for the
+       * life of the session.  That is the observed stall.
+       *
+       * Move any such container back to the head of rx.pend, preserving
+       * order, and re-arm below.  The RX IRQ is still disabled here (it
+       * is re-enabled a few lines down), so this cannot race the ISR and
+       * needs no extra locking -- which matters, because this function is
+       * called with priv->slock held from i2s_configure() but without it
+       * from i2s_rxsamplerate().
+       */
+
+      g_velapaw_rx_chst++;
+
+      while (!sq_empty(&priv->rx.act))
+        {
+          sq_addfirst(sq_remlast(&priv->rx.act), &priv->rx.pend);
+          g_velapaw_rx_resc++;
+        }
+
+      /* Harmless when nothing is pending: i2s_rxdma_start() returns OK
+       * immediately on an empty pend queue.  An EOF landing before the
+       * unmask below is not lost -- INT_RAW latches it and it is
+       * delivered as soon as SUC_EOF is unmasked.
+       */
+
+      i2s_rxdma_start(priv);
+
       /* Enable DMA interrupt */
 
       up_enable_irq(priv->rx_irq);
@@ -2641,6 +2757,16 @@ static int i2s_rx_interrupt(int irq, void *context, void *arg)
   uint32_t status = GET_GDMA_CH_REG(DMA_IN_INT_ST_CH0_REG,
                                     priv->dma_channel);
 
+  /* Patch #34: census before anything is cleared. */
+
+  g_velapaw_isr_rx++;
+  g_velapaw_isr_last = status;
+
+  if ((status & DMA_IN_SUC_EOF_CH0_INT_ST) == 0)
+    {
+      g_velapaw_isr_noeof++;
+    }
+
   SET_GDMA_CH_REG(DMA_IN_INT_CLR_CH0_REG, priv->dma_channel,
                   UINT32_MAX);
 
@@ -3505,4 +3631,227 @@ err:
   return NULL;
 }
 
+
+/****************************************************************************
+ * Name: velapaw_i2s_rx_kick
+ *
+ * Description:
+ *   VelaPaw patch #36.  Un-wedge the I2S0 RX path from thread context,
+ *   without going anywhere near the audio upper half.
+ *
+ *   When a capture stalls, mic.c's failure path hangs inside
+ *   mic_session_close() -- the voice worker never returns from
+ *   velapaw_mic_capture() at all, which is why exactly one capture is
+ *   ever attempted per boot.  So recovery cannot be built out of
+ *   AUDIOIOC_STOP / CONFIGURE / START: those are the calls under
+ *   suspicion.  This touches only registers and this driver's own
+ *   queues, so it cannot block.
+ *
+ *   Same hardware sequence as i2s_rx_channel_start(), plus an INT_CLR --
+ *   nothing has cleared the GDMA interrupt status since boot in a stalled
+ *   run, which is why intraw keeps reading the same stale value.
+ *
+ *   Thread context only.  Safe to call when nothing is wrong: the rescue
+ *   loop does not execute and i2s_rxdma_start() returns OK immediately on
+ *   an empty pend queue.
+ *
+ ****************************************************************************/
+
+void velapaw_i2s_rx_kick(void)
+{
+#ifdef CONFIG_ESP32S3_I2S0
+  struct esp32s3_i2s_s *priv = &esp32s3_i2s0_priv;
+  irqstate_t flags;
+
+  if (!priv->config->rx_en)
+    {
+      return;
+    }
+
+  flags = spin_lock_irqsave(&priv->slock);
+
+  g_velapaw_rx_kick++;
+
+  /* Stop RX and its inlink before touching anything else. */
+
+  modifyreg32(I2S_RX_CONF_REG(priv->config->port), I2S_RX_START, 0);
+  SET_GDMA_CH_BITS(DMA_IN_LINK_CH0_REG, priv->dma_channel,
+                   DMA_INLINK_STOP_CH0_M);
+
+  /* Reset the DMA operation, the RX channel and the RX FIFO -- the same
+   * three resets i2s_rx_channel_start() performs.
+   */
+
+  SET_GDMA_CH_BITS(DMA_IN_CONF0_CH0_REG, priv->dma_channel,
+                   DMA_IN_RST_CH0_M);
+  CLR_GDMA_CH_BITS(DMA_IN_CONF0_CH0_REG, priv->dma_channel,
+                   DMA_IN_RST_CH0_M);
+
+  modifyreg32(I2S_RX_CONF_REG(priv->config->port), 0, I2S_RX_RESET);
+  modifyreg32(I2S_RX_CONF_REG(priv->config->port), I2S_RX_RESET, 0);
+
+  modifyreg32(I2S_RX_CONF_REG(priv->config->port), 0, I2S_RX_FIFO_RESET);
+  modifyreg32(I2S_RX_CONF_REG(priv->config->port), I2S_RX_FIFO_RESET, 0);
+
+  modifyreg32(I2S_RX_CONF_REG(priv->config->port), 0, I2S_RX_UPDATE);
+
+  /* Drop the stale latched status so the next probe reading means
+   * something.  Only the ISR ever writes this, and in a stalled run the
+   * ISR does not run.
+   */
+
+  SET_GDMA_CH_REG(DMA_IN_INT_CLR_CH0_REG, priv->dma_channel, UINT32_MAX);
+
+  /* The resets above orphaned anything in flight: owner bit still set, no
+   * EOF will ever come, and while it sits in rx.act every later
+   * i2s_rxdma_start() bails at the !sq_empty(&priv->rx.act) test.  Put it
+   * back at the head of rx.pend, preserving order, and re-arm.
+   */
+
+  while (!sq_empty(&priv->rx.act))
+    {
+      sq_addfirst(sq_remlast(&priv->rx.act), &priv->rx.pend);
+      g_velapaw_rx_resc++;
+    }
+
+  i2s_rxdma_start(priv);
+
+  spin_unlock_irqrestore(&priv->slock, flags);
+#endif /* CONFIG_ESP32S3_I2S0 */
+}
+
+/****************************************************************************
+ * Name: velapaw_sqlen
+ *
+ * Description:
+ *   VelaPaw patch #34.  Length of a singly linked queue.  sq_count() is
+ *   not available in every NuttX vintage, and this is only ever called
+ *   from the probe, so walking it is fine.
+ *
+ ****************************************************************************/
+
+static int velapaw_sqlen(sq_queue_t *q)
+{
+  sq_entry_t *e;
+  int n = 0;
+
+  for (e = sq_peek(q); e != NULL; e = sq_next(e))
+    {
+      n++;
+    }
+
+  return n;
+}
+
+/****************************************************************************
+ * Name: velapaw_i2s_rxdesc
+ *
+ * Description:
+ *   VelaPaw patch #34.  Snapshot the in-flight RX descriptor chain and the
+ *   GDMA interrupt state.  This is THE measurement: bit 31 of a ctrl word
+ *   is the DMA owner bit and bits 12-23 are the length actually written.
+ *
+ *     owner 1, len 0     armed, nothing arriving -> upstream of the DMA
+ *     owner 0, len > 0   filled, EOF interrupt lost -> recoverable
+ *
+ *   Raw words are handed back undecoded so the caller needs no register
+ *   macros.  Read-only; thread context only.
+ *
+ ****************************************************************************/
+
+void velapaw_i2s_rxdesc(uint32_t *ctrl, int nctrl, int *nact, int *npend,
+                        int *ndone, uint32_t *intraw, uint32_t *intena,
+                        uint32_t *inlink)
+{
+#ifdef CONFIG_ESP32S3_I2S0
+  struct esp32s3_i2s_s *priv = &esp32s3_i2s0_priv;
+  struct esp32s3_buffer_s *bfcontainer;
+  struct esp32s3_dmadesc_s *d;
+  int i;
+
+  for (i = 0; i < nctrl; i++)
+    {
+      ctrl[i] = 0;
+    }
+
+  *nact  = velapaw_sqlen(&priv->rx.act);
+  *npend = velapaw_sqlen(&priv->rx.pend);
+  *ndone = velapaw_sqlen(&priv->rx.done);
+
+  /* The head of rx.act is the container the DMA is currently on -- the
+   * one that never completed.
+   */
+
+  bfcontainer = (struct esp32s3_buffer_s *)sq_peek(&priv->rx.act);
+  if (bfcontainer != NULL)
+    {
+      d = bfcontainer->dma_link;
+      for (i = 0; i < nctrl && d != NULL; i++)
+        {
+          ctrl[i] = d->ctrl;
+          d = d->next;
+        }
+    }
+
+#ifdef DMA_IN_INT_RAW_CH0_REG
+  *intraw = GET_GDMA_CH_REG(DMA_IN_INT_RAW_CH0_REG, priv->dma_channel);
+#else
+  *intraw = UINT32_MAX;
+#endif
+
+#ifdef DMA_IN_INT_ENA_CH0_REG
+  *intena = GET_GDMA_CH_REG(DMA_IN_INT_ENA_CH0_REG, priv->dma_channel);
+#else
+  *intena = UINT32_MAX;
+#endif
+
+#ifdef DMA_IN_LINK_CH0_REG
+  *inlink = GET_GDMA_CH_REG(DMA_IN_LINK_CH0_REG, priv->dma_channel);
+#else
+  *inlink = UINT32_MAX;
+#endif
+
+#else /* CONFIG_ESP32S3_I2S0 */
+  int i;
+
+  for (i = 0; i < nctrl; i++)
+    {
+      ctrl[i] = 0;
+    }
+
+  *nact = *npend = *ndone = -1;
+  *intraw = *intena = *inlink = UINT32_MAX;
+#endif /* CONFIG_ESP32S3_I2S0 */
+}
+
+/****************************************************************************
+ * Name: velapaw_i2s_rxdbg
+ *
+ * Description:
+ *   VelaPaw patch #33.  Snapshot the I2S0 RX/TX control registers so the
+ *   `velapaw voice` probe can say whether the clock and RX_START are
+ *   actually live at the moment capture stalls.  Read-only; call from
+ *   thread context only.
+ *
+ ****************************************************************************/
+
+void velapaw_i2s_rxdbg(uint32_t *rxconf, uint32_t *txconf,
+                       uint32_t *rxeofn)
+{
+  if (rxconf != NULL)
+    {
+      *rxconf = getreg32(I2S_RX_CONF_REG(0));
+    }
+
+  if (txconf != NULL)
+    {
+      *txconf = getreg32(I2S_TX_CONF_REG(0));
+    }
+
+  if (rxeofn != NULL)
+    {
+      *rxeofn = getreg32(I2S_RXEOF_NUM_REG(0));
+    }
+}
+
 #endif /* CONFIG_ESP32S3_I2S */
