+
   playbufs = (FAR struct ap_buffer_s **)
     calloc(playbuf_info.nbuffers, sizeof(FAR void *));
   if (playbufs == NULL)
@@ -468,9 +479,54 @@ static void *nxlooper_loopthread(pthread_addr_t pvarg)
           goto err_out;
         }
 
+      auderr("VP: L6 play[%d] ret=%d apb=%p\n", x, ret, playbufs[x]);
       dq_addlast(&playbufs[x]->dq_entry, &playdq);
     }
 
+  /* VelaPaw patch #6: on ESP32-S3 the I2S port runs full duplex with
+   * I2S_SIG_LOOPBACK set, so the RX module has no bit clock of its own --
+   * it shares BCLK/WS generated by the TX module.  Starting record first
+   * and play only on the first dequeue therefore deadlocks: RX waits for a
+   * clock that TX will not produce until RX hands back a buffer.  Start
+   * play up front; its pending queue is empty so no I2S_SEND is issued.
+   */
+
+  /* VelaPaw patch #7: submitting a buffer is what sets I2S_TX_START
+   * (esp32s3_i2s.c:709); AUDIOIOC_START alone only writes codec registers
+   * and spawns the worker thread.  Prime TX with one silent buffer so the
+   * module actually generates the BCLK/WS that RX borrows via
+   * I2S_SIG_LOOPBACK.  Enqueueing before start is the driver's own
+   * "priming the pump" path -- priv->mq is still NULL, so the buffer just
+   * lands on pendq and is drained by the start below.
+   */
+
+  apb = (FAR struct ap_buffer_s *)dq_remfirst(&playdq);
+  if (apb != NULL)
+    {
+      memset(apb->samp, 0, apb->nmaxbytes);
+      apb->nbytes  = apb->nmaxbytes;
+      apb->curbyte = 0;
+      ret = nxlooper_enqueueplaybuffer(plooper, apb);
+      auderr("VP: primed TX with silence ret=%d\n", ret);
+      if (ret != OK)
+        {
+          goto err_out;
+        }
+    }
+
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+  ret = ioctl(plooper->playdev_fd, AUDIOIOC_START,
+              (unsigned long)plooper->pplayses);
+#else
+  ret = ioctl(plooper->playdev_fd, AUDIOIOC_START, 0);
+#endif
+  if (ret < 0)
+    {
+      goto err_out;
+    }
+
+  auderr("VP: play started ret=%d\n", ret);
+
   /* Start the audio device */
 
 #ifdef CONFIG_AUDIO_MULTI_SESSION
@@ -485,9 +541,11 @@ static void *nxlooper_loopthread(pthread_addr_t pvarg)
     }
   else
     {
-      plooper->loopstate = NXLOOPER_STATE_RECORDING;
+      plooper->loopstate = NXLOOPER_STATE_LOOPING;
     }
 
+  auderr("VP: record started, entering loop\n");
+
   /* Loop until we specifically break.  running == true means that we are
    * still looping waiting for the loopback to complete.  All of the data
    * may have been sent, but the loopback is not complete until we get
@@ -509,7 +567,6 @@ static void *nxlooper_loopthread(pthread_addr_t pvarg)
 
       /* Validate a message was received */
 
-      audinfo("message received size %zd id%d\n", size, msg.msg_id);
       if (size != sizeof(msg))
         {
           /* Interrupted by a signal? What to do? */
@@ -530,6 +587,12 @@ static void *nxlooper_loopthread(pthread_addr_t pvarg)
               }
 
             apb = msg.u.ptr;
+            if (apb == NULL)
+              {
+                auderr("VP: NULL apb -- ignoring\n");
+                break;
+              }
+
             apb->curbyte = 0;
             if (apb->flags & AUDIO_APB_PLAY)
               {
@@ -548,8 +611,29 @@ static void *nxlooper_loopthread(pthread_addr_t pvarg)
                 apbrec = (FAR struct ap_buffer_s *)dq_peek(&recorddq);
                 apb = (FAR struct ap_buffer_s *)dq_peek(&playdq);
 
-                copy = MIN(apbrec->nbytes - apbrec->curbyte,
-                           apb->nmaxbytes - apb->curbyte);
+                /* VelaPaw patch #12: nbytes/curbyte are unsigned.  If a
+                 * requeued record buffer comes back with nbytes <
+                 * curbyte the subtraction wraps and memcpy runs off the
+                 * end of the buffer (EXCCAUSE=0x1c).  Print the operands
+                 * and refuse to copy on a bad state.
+                 */
+
+                fflush(stdout);
+
+                if (apbrec->samp == NULL || apb->samp == NULL ||
+                    apbrec->nbytes < apbrec->curbyte ||
+                    apb->nmaxbytes < apb->curbyte)
+                  {
+                    fflush(stdout);
+                    copy = 0;
+                  }
+                else
+                  {
+                    copy = MIN(apbrec->nbytes - apbrec->curbyte,
+                               apb->nmaxbytes - apb->curbyte);
+                  }
+
+                fflush(stdout);
 
                 memcpy(apb->samp + apb->curbyte,
                        apbrec->samp + apbrec->curbyte, copy);
@@ -1102,6 +1186,8 @@ int nxlooper_loopback(FAR struct nxlooper_s *plooper, int format,
       goto err_out;
     }
 
+  auderr("VP: M1 both configures done\n");
+
   /* Query the audio device for its preferred buffer size / qty */
 
   if ((ioctl(plooper->playdev_fd, AUDIOIOC_GETBUFFERINFO,
@@ -1112,6 +1198,8 @@ int nxlooper_loopback(FAR struct nxlooper_s *plooper, int format,
       buf_info.nbuffers = CONFIG_AUDIO_NUM_BUFFERS;
     }
 
+  auderr("VP: M2 bufinfo n=%d\n", (int)buf_info.nbuffers);
+
   /* Create a message queue for the loopthread */
 
   attr.mq_maxmsg  = buf_info.nbuffers + 8;
@@ -1132,14 +1220,20 @@ int nxlooper_loopback(FAR struct nxlooper_s *plooper, int format,
       goto err_out;
     }
 
+  auderr("VP: M3 mq opened\n");
+
   /* Register our message queue with the audio device */
 
   ioctl(plooper->recorddev_fd, AUDIOIOC_REGISTERMQ,
         (unsigned long)plooper->mq);
 
+  auderr("VP: M4 record mq registered\n");
+
   ioctl(plooper->playdev_fd, AUDIOIOC_REGISTERMQ,
         (unsigned long)plooper->mq);
 
+  auderr("VP: M5 play mq registered\n");
+
   /* Check if there was a previous thread and join it if there was
    * to perform clean-up.
    */
@@ -1147,7 +1241,7 @@ int nxlooper_loopback(FAR struct nxlooper_s *plooper, int format,
   nxlooper_jointhread(plooper);
 
   pthread_attr_init(&tattr);
