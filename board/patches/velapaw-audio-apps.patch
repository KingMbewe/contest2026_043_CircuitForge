@@ -1156,6 +1250,8 @@ int nxlooper_loopback(FAR struct nxlooper_s *plooper, int format,
    * race conditions.
    */
 
+  auderr("VP: M6 pre pthread_create\n");
+
   nxlooper_reference(plooper);
   ret = pthread_create(&plooper->loop_id, &tattr, nxlooper_loopthread,
