   /* Query the audio device for it's preferred buffer size / qty */
 
@@ -378,6 +379,9 @@ static void *nxlooper_loopthread(pthread_addr_t pvarg)
       recordbuf_info.nbuffers = CONFIG_AUDIO_NUM_BUFFERS;
     }
 
+  auderr("VP: L2 rec bufinfo size=%d n=%d\n",
+         (int)recordbuf_info.buffer_size, (int)recordbuf_info.nbuffers);
+
   /* Create array of pointers to buffers */
 
   recordbufs = (FAR struct ap_buffer_s **)
@@ -403,6 +407,8 @@ static void *nxlooper_loopthread(pthread_addr_t pvarg)
 
       ret = ioctl(plooper->recorddev_fd, AUDIOIOC_ALLOCBUFFER,
                   (unsigned long)&buf_desc);
+      auderr("VP: L3 rec[%d] ret=%d want=%d apb=%p\n",
+             x, ret, (int)sizeof(buf_desc), recordbufs[x]);
 
       if (ret != sizeof(buf_desc))
         {
@@ -419,7 +425,9 @@ static void *nxlooper_loopthread(pthread_addr_t pvarg)
     {
       /* Write the next buffer of data */
 
+      auderr("VP: L4 enq rec[%d]=%p\n", x, recordbufs[x]);
       ret = nxlooper_enqueuerecordbuffer(plooper, recordbufs[x]);
+      auderr("VP: L4 enq rec[%d] ret=%d\n", x, ret);
