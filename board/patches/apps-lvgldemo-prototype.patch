-  if (!lv_demos_create(&argv[1], argc - 1))
+  if (argc > 1 && strcmp(argv[1], "velapaw") == 0)
+    {
+      velapaw_create_ui();
+    }
+  else if (!lv_demos_create(&argv[1], argc - 1))
     {
